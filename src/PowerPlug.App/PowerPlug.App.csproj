<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe = a Windows program without a console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PowerPlug</AssemblyName>
    <!-- Keep the memory footprint small: workstation garbage collector without the extra background GC thread. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PowerPlug.Core\PowerPlug.Core.csproj" />
    <ProjectReference Include="..\PowerPlug.Modules.Awake\PowerPlug.Modules.Awake.csproj" />
    <ProjectReference Include="..\PowerPlug.Modules.AlwaysOnTop\PowerPlug.Modules.AlwaysOnTop.csproj" />
    <ProjectReference Include="..\PowerPlug.Modules.LightSwitch\PowerPlug.Modules.LightSwitch.csproj" />
  </ItemGroup>
</Project>
